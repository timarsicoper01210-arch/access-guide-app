{
  "expo": {
    "name": "access-guide-app",
    "slug": "access-guide-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "accessguideapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Cette application utilise la caméra pour détecter les obstacles devant vous et décrire votre environnement à voix haute.",
        "NSSpeechRecognitionUsageDescription": "Cette application utilise la reconnaissance vocale pour saisir votre destination à la voix.",
        "NSMicrophoneUsageDescription": "Cette application utilise le microphone pour saisir votre destination à la voix."
      },
      "bundleIdentifier": "com.anonymous.accessguideapp"
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.accessguideapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cette application utilise votre position pour vous guider à la marche."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cette application utilise le microphone pour saisir votre destination à la voix.",
          "speechRecognitionPermission": "Cette application utilise la reconnaissance vocale pour saisir votre destination à la voix."
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
